includes:
    - phpstan-baseline.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon
    - ../vendor/phpstan/phpstan-phpunit/extension.neon
parameters:
    level: 8
    paths:
        - ../
    excludePaths:
        - views
        - ../cache
        - ../panel/node_modules(?)
        - ../panel/views
        - ../site/templates
        - ../site/plugins
        - ../tests/*/Fixtures/*
        - ../vendor
    scanFiles:
        - ../index.php
    ignoreErrors:
        - '#^Call to an undefined method Formwork\\Data\\CollectionDataProxy#'
        - '#^Call to an undefined method Formwork\\Fields\\Field::#'
        - '#^Call to an undefined method Formwork\\Pages\\Page::#'
        - '#^Call to an undefined method Formwork\\Cms\\Site::#'
        - '#^Call to an undefined method Formwork\\Users\\User::#'
        -
            message: '#^Call to method PHPUnit\\Framework\\Assert::assert#'
            identifier: method.alreadyNarrowedType
            path: ../tests
        -
            message: '#^Call to an undefined method Formwork\\Cms\\App::#'
            path: ../tests
        -
            message: '#^Call to an undefined method Formwork\\Tests\\Unit\\[A-Za-z]+\\Fixtures\\#'
            path: ../tests
