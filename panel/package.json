{
    "private": true,
    "description": "Formwork CMS Administration Panel",
    "type": "module",
    "homepage": "https://getformwork.org",
    "license": "MIT",
    "contributors": [
        {
            "name": "Formwork Team",
            "url": "https://getformwork.org"
        }
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/getformwork/formwork.git",
        "directory": "panel"
    },
    "scripts": {
        "build": "pnpm clean && pnpm build:css && pnpm build:js",
        "build:css": "sass ./src/scss/panel.scss:./assets/css/panel.min.css --style=compressed --no-source-map",
        "build:js": "tsc && node build.js",
        "clean": "rm -rf ./assets/js/chunks/**/*.js",
        "watch": "pnpm watch:css & pnpm watch:js",
        "watch:css": "pnpm build:css --watch",
        "watch:js": "pnpm build:js --watch",
        "format": "pnpm format:css && pnpm format:ts",
        "format:css": "prettier './src/scss/**/*.scss' --write",
        "format:ts": "prettier './src/ts/**/*.ts' --write",
        "lint": "pnpm lint:css && pnpm lint:ts",
        "lint:css": "stylelint './src/scss/**/*.scss' --fix",
        "lint:ts": "eslint './src/ts/**/*.ts' --fix",
        "check": "pnpm check:css && pnpm check:ts",
        "check:css": "stylelint './src/scss/**/*.scss'",
        "check:ts": "eslint './src/ts/**/*.ts'",
        "dump:icons": "node ./src/scripts/dump-icons.js"
    },
    "dependencies": {
        "@codemirror/commands": "^6.10.3",
        "@codemirror/lang-markdown": "^6.5.0",
        "@codemirror/language": "^6.12.3",
        "@codemirror/state": "^6.6.0",
        "@codemirror/view": "^6.43.0",
        "@lezer/highlight": "^1.2.3",
        "chartist": "^1.5.0",
        "prosemirror-commands": "^1.7.1",
        "prosemirror-history": "^1.5.0",
        "prosemirror-inputrules": "^1.5.1",
        "prosemirror-keymap": "^1.2.3",
        "prosemirror-markdown": "^1.13.4",
        "prosemirror-model": "^1.25.7",
        "prosemirror-schema-list": "^1.5.1",
        "prosemirror-state": "^1.4.4",
        "prosemirror-view": "^1.41.8",
        "sortablejs": "^1.15.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/sortablejs": "^1.15.9",
        "esbuild": "^0.28.0",
        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.6.0",
        "postcss": "^8.5.15",
        "prettier": "^3.8.3",
        "sass": "^1.100.0",
        "stylelint": "^17.12.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-order": "^8.1.1",
        "stylelint-scss": "^7.1.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.60.1"
    },
    "packageManager": "pnpm@11.2.2+sha512.36e6621fad506178936455e70247b8808ef4ec25797a9f437a93281a020484e2607f6a469a22e982987c3dbb8866e3071514ab10a4a1749e06edcd1ec118436f"
}
