{
    "private": true,
    "description": "Formwork CMS Administration Panel",
    "type": "module",
    "homepage": "https://getformwork.org",
    "license": "MIT",
    "contributors": [
        {
            "name": "Formwork Team",
            "url": "https://getformwork.org"
        }
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/getformwork/formwork.git",
        "directory": "panel"
    },
    "scripts": {
        "build": "pnpm clean && pnpm build:css && pnpm build:js",
        "build:css": "sass ./src/scss/panel.scss:./assets/css/panel.min.css --style=compressed --no-source-map",
        "build:js": "tsc && node build.js",
        "clean": "rm -rf ./assets/js/chunks/**/*.js",
        "watch": "pnpm watch:css & pnpm watch:js",
        "watch:css": "pnpm build:css --watch",
        "watch:js": "pnpm build:js --watch",
        "format": "pnpm format:css && pnpm format:ts",
        "format:css": "prettier './src/scss/**/*.scss' --write",
        "format:ts": "prettier './src/ts/**/*.ts' --write",
        "lint": "pnpm lint:css && pnpm lint:ts",
        "lint:css": "stylelint './src/scss/**/*.scss' --fix",
        "lint:ts": "eslint './src/ts/**/*.ts' --fix",
        "check": "pnpm check:css && pnpm check:ts",
        "check:css": "stylelint './src/scss/**/*.scss'",
        "check:ts": "eslint './src/ts/**/*.ts'",
        "dump:icons": "node ./src/scripts/dump-icons.js"
    },
    "dependencies": {
        "@codemirror/commands": "^6.11.0",
        "@codemirror/lang-markdown": "^6.5.2",
        "@codemirror/language": "^6.12.4",
        "@codemirror/state": "^6.7.1",
        "@codemirror/view": "^6.43.9",
        "@lezer/highlight": "^1.2.3",
        "chartist": "^1.5.0",
        "prosemirror-commands": "^1.7.2",
        "prosemirror-history": "^1.5.0",
        "prosemirror-inputrules": "^1.5.1",
        "prosemirror-keymap": "^1.2.3",
        "prosemirror-markdown": "^1.13.6",
        "prosemirror-model": "^1.25.11",
        "prosemirror-schema-list": "^1.5.1",
        "prosemirror-state": "^1.4.4",
        "prosemirror-view": "^1.42.3",
        "sortablejs": "^1.15.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/sortablejs": "^1.15.9",
        "@typescript/native": "npm:typescript@^7.0.2",
        "esbuild": "^0.28.2",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.11.0",
        "postcss": "^8.5.26",
        "prettier": "^3.9.6",
        "sass": "^1.103.1",
        "stylelint": "^17.14.1",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-order": "^8.1.1",
        "stylelint-scss": "^7.2.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.68.0"
    },
    "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
