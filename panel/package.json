{
    "private": true,
    "description": "Formwork CMS Administration Panel",
    "type": "module",
    "homepage": "https://getformwork.org",
    "license": "MIT",
    "contributors": [
        {
            "name": "Formwork Team",
            "url": "https://getformwork.org"
        }
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/getformwork/formwork.git",
        "directory": "panel"
    },
    "scripts": {
        "build": "pnpm clean && pnpm build:css && pnpm build:js",
        "build:css": "sass ./src/scss/panel.scss:./assets/css/panel.min.css --style=compressed --no-source-map",
        "build:js": "tsc && node build.js",
        "clean": "rm -rf ./assets/js/chunks/**/*.js",
        "watch": "pnpm watch:css & pnpm watch:js",
        "watch:css": "pnpm build:css --watch",
        "watch:js": "pnpm build:js --watch",
        "lint": "pnpm lint:css && pnpm lint:ts",
        "lint:css": "biome check './src/scss/' --fix",
        "lint:ts": "biome check './src/ts/' './tests/' --fix",
        "check": "pnpm check:css && pnpm check:ts",
        "check:css": "biome check './src/scss/'",
        "check:ts": "biome check './src/ts/' './tests/'",
        "dump:icons": "node ./src/scripts/dump-icons.js",
        "test": "node --import ./tests/setup.ts --test 'tests/**/*.test.ts'",
        "test:types": "tsc -p ./tests"
    },
    "dependencies": {
        "@codemirror/commands": "^6.11.1",
        "@codemirror/lang-markdown": "^6.5.2",
        "@codemirror/language": "^6.13.1",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.15",
        "@lezer/highlight": "^1.2.5",
        "@preact/signals-core": "^1.14.5",
        "chartist": "^2.3.0",
        "markdown-it": "^14.3.3",
        "prosemirror-commands": "^1.7.2",
        "prosemirror-history": "^1.5.2",
        "prosemirror-inputrules": "^1.7.0",
        "prosemirror-keymap": "^1.2.3",
        "prosemirror-markdown": "^1.14.0",
        "prosemirror-model": "^1.25.13",
        "prosemirror-schema-list": "^1.6.1",
        "prosemirror-state": "^1.4.4",
        "prosemirror-tables": "^1.8.5",
        "prosemirror-transform": "^1.12.7",
        "prosemirror-view": "^1.44.0",
        "sortablejs": "^1.15.7"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.9",
        "@happy-dom/global-registrator": "^21.0.4",
        "@types/markdown-it": "^14.2.0",
        "@types/node": "^26.6.7",
        "@types/sortablejs": "^1.15.9",
        "esbuild": "^0.28.2",
        "sass": "^1.108.2",
        "typescript": "^7.0.2"
    },
    "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
}
