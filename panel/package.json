{
    "private": true,
    "description": "Formwork CMS Administration Panel",
    "type": "module",
    "homepage": "https://getformwork.org",
    "license": "MIT",
    "contributors": [
        {
            "name": "Formwork Team",
            "url": "https://getformwork.org"
        }
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/getformwork/formwork.git",
        "directory": "panel"
    },
    "scripts": {
        "build": "pnpm clean && pnpm build:css && pnpm build:js",
        "build:css": "sass ./src/scss/panel.scss:./assets/css/panel.min.css --style=compressed --no-source-map",
        "build:js": "tsc && node build.js",
        "clean": "rm -rf ./assets/js/chunks/**/*.js",
        "watch": "pnpm watch:css & pnpm watch:js",
        "watch:css": "pnpm build:css --watch",
        "watch:js": "pnpm build:js --watch",
        "lint": "pnpm lint:css && pnpm lint:ts",
        "lint:css": "stylelint './src/scss/**/*.scss' --fix",
        "lint:ts": "biome check './src/ts/' --fix",
        "check": "pnpm check:css && pnpm check:ts",
        "check:css": "stylelint './src/scss/**/*.scss'",
        "check:ts": "biome check './src/ts/'",
        "dump:icons": "node ./src/scripts/dump-icons.js"
    },
    "dependencies": {
        "@codemirror/commands": "^6.11.1",
        "@codemirror/lang-markdown": "^6.5.2",
        "@codemirror/language": "^6.13.1",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.14",
        "@lezer/highlight": "^1.2.5",
        "@preact/signals-core": "^1.14.4",
        "chartist": "^1.5.0",
        "prosemirror-commands": "^1.7.2",
        "prosemirror-history": "^1.5.1",
        "prosemirror-inputrules": "^1.5.1",
        "prosemirror-keymap": "^1.2.3",
        "prosemirror-markdown": "^1.13.8",
        "prosemirror-model": "^1.25.12",
        "prosemirror-schema-list": "^1.5.1",
        "prosemirror-state": "^1.4.4",
        "prosemirror-view": "^1.42.6",
        "sortablejs": "^1.15.7"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.2",
        "@types/sortablejs": "^1.15.9",
        "esbuild": "^0.28.2",
        "postcss": "^8.5.30",
        "sass": "^1.105.1",
        "stylelint": "^17.16.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-order": "^8.1.2",
        "stylelint-scss": "^7.3.0",
        "typescript": "^7.0.2"
    },
    "packageManager": "pnpm@11.28.5+sha512.484563d30b4c2ad27cb48aa94ff2b302dbcebc8ff6bf28816c2589886e146ce7f76f354f3bc1a438e6f5e9768c302aa0a6f7add8232903cd4cf81426cbc14d9e"
}
