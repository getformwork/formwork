<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true" backupGlobals="false">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">./formwork/src</directory>
        </include>
        <exclude>
            <directory suffix=".php">./formwork/src/Images/Exif/tables</directory>
            <directory suffix=".php">./formwork/src/Utils/scripts</directory>
        </exclude>
    </source>
</phpunit>